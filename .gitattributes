# Line endings (final-review №1): LF everywhere, so Prettier passes on Windows
# whatever core.autocrlf says. Windows batch files keep CRLF, which cmd.exe needs.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.woff binary
*.woff2 binary
