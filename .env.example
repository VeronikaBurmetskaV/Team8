# Template only: copy to .env and fill in. Never commit .env.
# Local development needs none of these: `npm run dev` uses profile dev with the embedded Postgres.

SPRING_PROFILES_ACTIVE=dev

# Only for a real Postgres (e.g. the optional Neon deploy, ADR-0010)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>
